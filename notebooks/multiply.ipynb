   "source": [
    "def multiply(a,b):\n",
    "    return (a*b)\n",
    "\n",
    "print(multiply(10,3))\n",
    "print(multiply(7,6))\n",
    "print(multiply(21,4))\n",
    "\n",
    "def square(x):\n",
    "    return multiply(x,x)\n",
    "\n",
    "print(square(5))\n",
    "print(square(8))\n",
    "print(square(12))"
   ]
  }
