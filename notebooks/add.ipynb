    "#define addition function\n",
    "def add(a, b):\n",
    "    return b + a\n",
    "\n",
    "def sum_list(values):\n",
    "    counter = 0\n",
    "    for i in range(len(values)):\n",
    "        x = add(counter, values[i])\n",
    "        counter = x\n",
    "    return counter\n",
    "\n",
    "print(sum_list([1,2,2,1]))"
   ]
  }
